# ==============================================================================
# Appointment System — Backend Environment Configuration
# Copy this file to .env and adjust your configuration values.
# ==============================================================================

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_system
SECRET_KEY=change_me_in_production

# ==============================================================================
# Email (SMTP) Configuration
# Leave SMTP_SERVER empty to run in simulation mode (logs email to server console)
# For Gmail: Use smtp.gmail.com, port 587, and generate a 16-character App Password.
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Ministry Appointment Portal"

# ==============================================================================
# SMS Gateway Configuration
# Leave SMS_API_KEY empty to run in simulation mode (logs SMS to server console)
# Example for Notify.lk (Sri Lanka SMS Gateway):
# ==============================================================================
SMS_GATEWAY_URL=https://app.notify.lk/api/v1/send
SMS_USER_ID=your_notify_lk_user_id
SMS_API_KEY=your_notify_lk_api_key
SMS_SENDER_ID=AppointSys
